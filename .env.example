# ==========================================
# WhatsApp AI Agent Configuration
# ==========================================

# 1. Gemini API Key (Get your free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# 2. WhatsApp Pairing Option (Optional: enter your phone number with country code, e.g. 919876543210)
# If left blank, a QR code will be generated in your terminal instead.
PHONE_NUMBER=

# 3. Your Persona / Identity
YOUR_NAME=Alex
PERSONA_STYLE=Friendly, casual, concise. Replies like a real human texting on WhatsApp. Never gives long formal essays. Uses natural punctuation, occasional emojis, and speaks in the same language or slang as the sender.

# 3. Automation Controls
AUTO_REPLY_ENABLED=true
IGNORE_GROUPS=true

# 4. Human Typing Delay (in milliseconds)
# Simulates reading and typing so replies don't feel instantaneous/robotic
MIN_TYPING_DELAY_MS=2000
MAX_TYPING_DELAY_MS=5000

# 6. Email Delivery Configuration
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=sales@gymstack.in
SMTP_PASS=your_email_password_here

